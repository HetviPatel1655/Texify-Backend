  updatedBy        User?         @relation("BankEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  adjustments      BankEntryAdjustment[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId, deletedAt])
  @@index([type])
  @@index([partyId])
  @@index([entryDate])
}

model BankEntryAdjustment {
  id          String    @id @default(uuid())
  bankEntryId String
  bankEntry   BankEntry @relation(fields: [bankEntryId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Decimal

  @@index([bankEntryId])
  @@index([invoiceId])
}

model Employee {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  employeeType EmployeeType @default(OTHER)
  dailyRate    Decimal      @default(0)
  isActive     Boolean      @default(true)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdById  String?
  updatedById  String?
  createdBy    User?        @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  attendances  Attendance[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([employeeType])
  @@index([isActive])
}

model Attendance {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@index([tenantId, date])
}
