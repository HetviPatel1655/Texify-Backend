generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ChallanStatus {
  DRAFT
  ISSUED
  PARTIALLY_RETURNED
  CLOSED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum UnitType {
  PIECE
  KILOGRAM
  METER
  LITER
  ROLL
  SET
  BOX
  DOZEN
  TAKA
}

enum GSTType {
  TAXABLE
  EXEMPT
  NIL
  RCM
}

enum DocumentType {
  INVOICE
  CHALLAN
}

enum ChallanType {
  SALE
  GREY
  FINISHED_TAKA
  DIRECT
  SAREES
  BEAM
  YARN_SALE
}

enum BankEntryType {
  SLIP
  CHEQUE
}

enum EmployeeType {
  WEAVER
  HELPER
  SUPERVISOR
  WINDER
  WARPER
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  PAUSED
  CANCELLED
  COMPLETED
  EXPIRED
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          TenantUser[]
  companyProfile CompanyProfile?
  subscription   Subscription?
  systemSettings SystemSetting[]
  parties        Party[]
  products       Product[]
  invoices       Invoice[]
  challans       Challan[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  saleOrders     SaleOrder[]
  yarnPurchases    YarnPurchase[]
  yarnIssues       YarnIssue[]
  beams            Beam[]
  beamSendJobworks BeamSendJobwork[]
  takas              Taka[]
  greyTPs            GreyTP[]
  returnTakas        ReturnTaka[]
  challanTakaEntries ChallanTakaEntry[]
  challanBeamEntries ChallanBeamEntry[]
  challanYarnEntries ChallanYarnEntry[]
  yarnSendJobworks     YarnSendJobwork[]
  yarnReceiveJobworks  YarnReceiveJobwork[]
  paletteSendJobworks  PaletteSendJobwork[]
  rollsSendJobworks    RollsSendJobwork[]
  takaReceiveJobworks  TakaReceiveJobwork[]
  bankEntries          BankEntry[]
  employees            Employee[]
  attendances          Attendance[]
}

model TenantUser {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model CompanyProfile {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName   String
  tagline       String?
  logoUrl       String?
  businessType  String?
  address1      String
  address2      String?
  city          String
  state         String
  stateCode     String
  postalCode    String?
  country       String   @default("India")
  phone         String?
  email         String?
  gstin         String
  pan           String?
  msme          String?
  bankName      String?
  bankAccountNo String?
  bankIfsc      String?
  bankBranch    String?
  defaultTerms  String?
  defaultNotes  String?
  interestRate  Decimal  @default(0)
  jurisdiction  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

enum OrderStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role                String    @default("USER")
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenantUsers            TenantUser[]
  createdParties         Party[]          @relation("PartyCreatedBy")
  updatedParties         Party[]          @relation("PartyUpdatedBy")
  createdProducts        Product[]        @relation("ProductCreatedBy")
  updatedProducts        Product[]        @relation("ProductUpdatedBy")
  createdInvoices        Invoice[]        @relation("InvoiceCreatedBy")
  updatedInvoices        Invoice[]        @relation("InvoiceUpdatedBy")
  createdChallans        Challan[]        @relation("ChallanCreatedBy")
  updatedChallans        Challan[]        @relation("ChallanUpdatedBy")
  createdPayments        Payment[]        @relation("PaymentCreatedBy")
  createdPurchaseOrders  PurchaseOrder[]  @relation("PurchaseOrderCreatedBy")
  updatedPurchaseOrders  PurchaseOrder[]  @relation("PurchaseOrderUpdatedBy")
  createdSaleOrders      SaleOrder[]      @relation("SaleOrderCreatedBy")
  updatedSaleOrders      SaleOrder[]      @relation("SaleOrderUpdatedBy")
  createdYarnPurchases   YarnPurchase[]   @relation("YarnPurchaseCreatedBy")
  updatedYarnPurchases   YarnPurchase[]   @relation("YarnPurchaseUpdatedBy")
  createdYarnIssues      YarnIssue[]      @relation("YarnIssueCreatedBy")
  updatedYarnIssues      YarnIssue[]      @relation("YarnIssueUpdatedBy")
  createdBeams           Beam[]           @relation("BeamCreatedBy")
  updatedBeams           Beam[]           @relation("BeamUpdatedBy")
  createdBeamSends       BeamSendJobwork[] @relation("BeamSendCreatedBy")
  updatedBeamSends       BeamSendJobwork[] @relation("BeamSendUpdatedBy")
  createdTakas           Taka[]            @relation("TakaCreatedBy")
  updatedTakas           Taka[]            @relation("TakaUpdatedBy")
  createdGreyTPs         GreyTP[]          @relation("GreyTPCreatedBy")
  updatedGreyTPs         GreyTP[]          @relation("GreyTPUpdatedBy")
  createdReturnTakas     ReturnTaka[]      @relation("ReturnTakaCreatedBy")
  updatedReturnTakas     ReturnTaka[]      @relation("ReturnTakaUpdatedBy")
  createdYarnSends       YarnSendJobwork[]    @relation("YarnSendCreatedBy")
  updatedYarnSends       YarnSendJobwork[]    @relation("YarnSendUpdatedBy")
  createdYarnReceives    YarnReceiveJobwork[] @relation("YarnReceiveCreatedBy")
  updatedYarnReceives    YarnReceiveJobwork[] @relation("YarnReceiveUpdatedBy")
  createdPaletteSends    PaletteSendJobwork[] @relation("PaletteSendCreatedBy")
  updatedPaletteSends    PaletteSendJobwork[] @relation("PaletteSendUpdatedBy")
  createdRollsSends      RollsSendJobwork[]   @relation("RollsSendCreatedBy")
  updatedRollsSends      RollsSendJobwork[]   @relation("RollsSendUpdatedBy")
  createdTakaReceives    TakaReceiveJobwork[] @relation("TakaReceiveCreatedBy")
  updatedTakaReceives    TakaReceiveJobwork[] @relation("TakaReceiveUpdatedBy")
  createdBankEntries     BankEntry[]          @relation("BankEntryCreatedBy")
  updatedBankEntries     BankEntry[]          @relation("BankEntryUpdatedBy")
  createdEmployees       Employee[]           @relation("EmployeeCreatedBy")
  updatedEmployees       Employee[]           @relation("EmployeeUpdatedBy")
}

model Party {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code               String
  name               String
  partyType          PartyType
  email              String?
  phone              String?
  gstin              String?
  panNo              String?
  billingAddress1    String?
  billingAddress2    String?
  billingCity        String?
  billingState       String?
  billingStateCode   String?
  billingPostalCode  String?
  billingCountry     String?
  shippingAddress1   String?
  shippingAddress2   String?
  shippingCity       String?
  shippingState      String?
  shippingStateCode  String?
  shippingPostalCode String?
  shippingCountry    String?
  dueDays            Int?
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?
  updatedById        String?
  createdBy          User?     @relation("PartyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?     @relation("PartyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  invoices           Invoice[]
  challans           Challan[]
  purchaseOrders     PurchaseOrder[]
  saleOrders         SaleOrder[]
  yarnPurchases      YarnPurchase[]  @relation("YarnPurchaseParty")
  beams              Beam[]          @relation("BeamParty")
  beamSendFirms      BeamSendJobwork[] @relation("BeamSendFirm")
  beamSendParties    BeamSendJobwork[] @relation("BeamSendParty")
  takas              Taka[]            @relation("TakaFirm")
  returnTakas        ReturnTaka[]      @relation("ReturnTakaParty")
  yarnSendFirms      YarnSendJobwork[]    @relation("YarnSendFirm")
  yarnSendParties    YarnSendJobwork[]    @relation("YarnSendParty")
  yarnReceiveParties YarnReceiveJobwork[] @relation("YarnReceiveParty")
  paletteSendParties PaletteSendJobwork[] @relation("PaletteSendParty")
  rollsSendParties   RollsSendJobwork[]   @relation("RollsSendParty")
  takaReceiveFirms   TakaReceiveJobwork[] @relation("TakaReceiveFirm")
  takaReceiveParties TakaReceiveJobwork[] @relation("TakaReceiveParty")
  bankEntries        BankEntry[]

  @@unique([tenantId, code])
  @@unique([tenantId, gstin])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([partyType])
  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
  @@index([partyType, isActive])
}

model Product {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku            String?
  name           String
  description    String?
  hsnCode        String?
  unitType       UnitType
  gstType        GSTType       @default(TAXABLE)
  gstRate        Decimal       @default(5)
  purchaseRate   Decimal       @default(0)
  sellingRate    Decimal       @default(0)
  trackInventory Boolean       @default(false)
  openingStock   Decimal       @default(0)
  reorderLevel   Decimal       @default(0)
  isActive       Boolean       @default(true)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  updatedById    String?
  createdBy      User?         @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?         @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  invoiceItems       InvoiceItem[]
  challanItems       ChallanItem[]
  purchaseOrderItems PurchaseOrderItem[]
  saleOrderItems     SaleOrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([name])
  @@index([unitType])
  @@index([gstType])
  @@index([isActive])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
  @@index([unitType, isActive])
}

model Invoice {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentType    DocumentType  @default(INVOICE)
  invoiceNumber   String
  seriesCode      String
  sequenceNumber  Int
  fiscalYear      String
  partyId         String
  party           Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  status          InvoiceStatus @default(DRAFT)
  paymentStatus   PaymentStatus @default(UNPAID)
  gstType         GSTType       @default(TAXABLE)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  dueDays         Int?
  orderNo         String?
  agentName       String?
  transporterName String?
  transportMode   String?
  vehicleNumber   String?
  lrNo            String?
  eWayBillNo      String?
  placeOfSupply   String?
  challanId       String?
  challan         Challan?      @relation(fields: [challanId], references: [id], onDelete: SetNull)
  notes           String?
  terms           String?
  remark          String?
  interestRate    Decimal?
  subtotal        Decimal       @default(0)
  discountAmount  Decimal       @default(0)
  taxableAmount   Decimal       @default(0)
  gstAmount       Decimal       @default(0)
  sgstRate        Decimal       @default(0)
  sgstAmount      Decimal       @default(0)
  cgstRate        Decimal       @default(0)
  cgstAmount      Decimal       @default(0)
  igstRate        Decimal       @default(0)
  igstAmount      Decimal       @default(0)
  freightCharges  Decimal       @default(0)
  roundOff        Decimal       @default(0)
  grandTotal      Decimal       @default(0)
  paidAmount      Decimal       @default(0)
  balanceAmount   Decimal       @default(0)
  bankName        String?
  bankAccountNo   String?
  bankIfsc        String?
  bankBranch      String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?
  updatedById     String?
  createdBy       User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?         @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items                InvoiceItem[]
  payments             Payment[]
  bankEntryAdjustments BankEntryAdjustment[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, seriesCode, sequenceNumber, fiscalYear])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([partyId])
  @@index([status])
  @@index([paymentStatus])
  @@index([issueDate])
  @@index([deletedAt])
  @@index([seriesCode, fiscalYear])
  @@index([partyId, issueDate])
  @@index([challanId])
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String
  productId      String?
  description    String
  hsnCode        String?
  quantity       Decimal
  pieces         Decimal?
  unit           String
  unitType       UnitType
  rate           Decimal
  discountAmount Decimal  @default(0)
  gstRate        Decimal  @default(0)
  taxableAmount  Decimal
  gstAmount      Decimal  @default(0)
  subtotal       Decimal
  grandTotal     Decimal
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

model Challan {
  id                 String        @id @default(uuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentType       DocumentType  @default(CHALLAN)
  challanType        ChallanType   @default(SALE)
  challanNumber      String
  seriesCode         String
  sequenceNumber     Int
  fiscalYear         String
  partyId            String
  party              Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  status             ChallanStatus @default(DRAFT)
  issueDate          DateTime      @default(now())
  agentName          String?
  notes              String?
  terms              String?
  remark             String?
  transportMode      String?
  vehicleNumber      String?
  placeOfSupply      String?
  deliveryPartyName  String?
  deliveryAddress1   String?
  deliveryAddress2   String?
  deliveryCity       String?
  deliveryState      String?
  deliveryPostalCode String?
  deliveryGstin      String?
  deliveryPhone      String?
  designNo           String?
  dubbleNo           String?
  mobileNo           String?
  insideNo           String?
  dripNo             String?
  goodsRate          Decimal       @default(0)
  goodsAmount        Decimal       @default(0)
  totalPcs           Int           @default(0)
  totalCartons       Int           @default(0)
  totalTakas         Int           @default(0)
  totalMeters        Decimal       @default(0)
  totalWeight        Decimal       @default(0)
  subtotal           Decimal       @default(0)
  discountAmount     Decimal       @default(0)
  gstAmount          Decimal       @default(0)
  roundOff           Decimal       @default(0)
  grandTotal         Decimal       @default(0)
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdById        String?
  updatedById        String?
  createdBy          User?         @relation("ChallanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?         @relation("ChallanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items              ChallanItem[]
  takaEntries        ChallanTakaEntry[]
  beamEntries        ChallanBeamEntry[]
  yarnEntries        ChallanYarnEntry[]
  invoices           Invoice[]

  @@unique([tenantId, challanNumber])
  @@unique([tenantId, seriesCode, sequenceNumber, fiscalYear])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([partyId])
  @@index([status])
  @@index([issueDate])
  @@index([deletedAt])
  @@index([seriesCode, fiscalYear])
  @@index([partyId, issueDate])
}

model ChallanItem {
  id             String             @id @default(uuid())
  challanId      String
  productId      String?
  description    String
  hsnCode        String?
  quantity       Decimal
  unit           String
  unitType       UnitType
  rate           Decimal
  discountAmount Decimal            @default(0)
  gstRate        Decimal            @default(0)
  taxableAmount  Decimal
  gstAmount      Decimal            @default(0)
  subtotal       Decimal
  grandTotal     Decimal
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  challan        Challan            @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product        Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  rollEntries    ChallanRollEntry[]

  @@index([challanId])
  @@index([productId])
}

model ChallanRollEntry {
  id            String      @id @default(uuid())
  challanItemId String
  serialNumber  Int
  meters        Decimal
  createdAt     DateTime    @default(now())
  challanItem   ChallanItem @relation(fields: [challanItemId], references: [id], onDelete: Cascade)

  @@index([challanItemId])
  @@unique([challanItemId, serialNumber])
}

model Payment {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal
  method      PaymentMethod
  referenceNo String?
  paymentDate DateTime      @default(now())
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?
  createdBy   User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([tenantId, deletedAt])
}

model Subscription {
  id                     String             @id @default(uuid())
  tenantId               String             @unique
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  razorpaySubscriptionId String?            @unique
  razorpayCustomerId     String?
  razorpayPlanId         String?
  planName               String             @default("free")
  status                 SubscriptionStatus @default(CREATED)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtCycleEnd       Boolean            @default(false)
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  payments               SubscriptionPayment[]
}

model SubscriptionPayment {
  id                String       @id @default(uuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  razorpayPaymentId String       @unique
  amount            Decimal
  currency          String       @default("INR")
  status            String
  paidAt            DateTime?
  createdAt         DateTime     @default(now())

  @@index([subscriptionId])
}

model PurchaseOrder {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber    String
  orderDate      DateTime    @default(now())
  partyId        String
  party          Party       @relation(fields: [partyId], references: [id], onDelete: Restrict)
  status         OrderStatus @default(OPEN)
  remarks        String?
  totalPieces    Decimal     @default(0)
  totalQuantity  Decimal     @default(0)
  totalAmount    Decimal     @default(0)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String?
  updatedById    String?
  createdBy      User?       @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?       @relation("PurchaseOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items          PurchaseOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([partyId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  description     String
  pieces          Decimal       @default(0)
  quantity        Decimal       @default(0)
  rate            Decimal       @default(0)
  amount          Decimal       @default(0)
  remarks         String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

model SaleOrder {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber    String
  orderDate      DateTime    @default(now())
  partyId        String
  party          Party       @relation(fields: [partyId], references: [id], onDelete: Restrict)
  agentName      String?
  partyMobileNo  String?
  status         OrderStatus @default(OPEN)
  orderDueDays   Int?
  orderDueDate   DateTime?
  billDueDays    Int?
  remarks        String?
  totalPieces    Decimal     @default(0)
  totalQuantity  Decimal     @default(0)
  totalAmount    Decimal     @default(0)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String?
  updatedById    String?
  createdBy      User?       @relation("SaleOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?       @relation("SaleOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items          SaleOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([partyId])
  @@index([status])
  @@index([orderDate])
}

model YarnPurchase {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serialNumber   String
  purchaseDate   DateTime    @default(now())
  billNo         String?
  billDate       DateTime?
  partyId        String
  party          Party       @relation("YarnPurchaseParty", fields: [partyId], references: [id], onDelete: Restrict)
  billType       String      @default("PURCHASE ACCOUNT")
  totalCartons   Int         @default(0)
  totalCheese    Decimal     @default(0)
  totalGrossWt   Decimal     @default(0)
  totalTareWt    Decimal     @default(0)
  totalNetWt     Decimal     @default(0)
  totalAmount    Decimal     @default(0)
  igstRate       Decimal     @default(0)
  igstAmount     Decimal     @default(0)
  cgstRate       Decimal     @default(0)
  cgstAmount     Decimal     @default(0)
  sgstRate       Decimal     @default(0)
  sgstAmount     Decimal     @default(0)
  billAmount     Decimal     @default(0)
  adjustedAmount Decimal     @default(0)
  gstReceived    Boolean     @default(false)
  billRemarks    String?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String?
  updatedById    String?
